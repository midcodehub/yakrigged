# =====================================================================
# YakRigged 环境变量示例
# 复制为 .env.local（本地）或在 Vercel Project Settings → Environment Variables
# 里逐项配置。所有 NEXT_PUBLIC_* 都会进客户端 bundle，请勿放敏感信息。
# =====================================================================

# 站点正式域名（影响 canonical / sitemap / RSS / OG）。
# 部署到正式域名时必填。本地开发可以不填，会 fallback 到 yakrigged.com。
NEXT_PUBLIC_SITE_URL=https://yakrigged.com

# Google Search Console 验证（"meta tag" 模式，把 content 值粘进来）
# 在 Search Console 添加资源后，选择 HTML 标记验证方式：
#   <meta name="google-site-verification" content="XXXXX">
# 把 XXXXX 粘到下面即可。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools 验证（同上，meta 模式）
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# =====================================================================
# Newsletter 配置
# ---------------------------------------------------------------------
# 没配置时订阅表单显示 "Coming soon"，不会真请求第三方。
# 当前支持的 provider：
#   - kit       （默认推荐 —— ConvertKit / Kit；免费 10K 订阅；无 KYC）
#   - beehiiv   （需 Stripe Identity 验证，已不推荐做主力）
# =====================================================================

# 切换 provider 时改这里
NEWSLETTER_PROVIDER=kit

# ---------- 选项 A：Kit (ConvertKit) ----------
# 1. 去 kit.com 注册账号
# 2. 创建一个 Form（Forms → + Create New → Inline form 即可，默认 single-opt-in）
# 3. API Key:    Settings → Advanced → "V3 API Key"（不是 API Secret，前者权限刚好够）
# 4. Form ID:    打开 Form 后地址栏 /forms/<这串数字>/ —— 复制那串数字
KIT_API_KEY=
KIT_FORM_ID=

# ---------- 选项 B：Beehiiv（备用） ----------
# 在 Beehiiv 后台 → Settings → Integrations → API 拿到（需先做 Stripe 验证）
BEEHIIV_API_KEY=
# 在 Beehiiv 后台 → Settings → Publication ID（V2 那个，pub_ 开头）
BEEHIIV_PUBLICATION_ID=

# =====================================================================
# Amazon Associates 配置
# ---------------------------------------------------------------------
# 给 <AffiliateLink asin="..."> 组件用。配置后：
#   - MDX 里写 <AffiliateLink asin="B07YPN7XYZ">名字</AffiliateLink>
#   - 自动渲染成带 tag 的合规 affiliate 链接 + rel=sponsored
#
# 没配时：链接照常能点，但不带 tag → 没佣金。构建会打一次 warning 提醒。
# 改 tag：只改这个 env，所有文章里的 affiliate 链接全部跟着换。
#
# Tag 格式：通常 "yourname-20"（美区）。你在 Amazon Associates 后台能看到。
# =====================================================================
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=yakrigged-20

# =====================================================================
# 留言系统（Comment System）配置
# ---------------------------------------------------------------------
# 自建评论系统用。完整设计见 docs/comment-system-design.md。
# 没配置时评论组件显示降级提示，不会报错。
#
# 安全红线：带 NEXT_PUBLIC_ 前缀的会进客户端 bundle（任何人可见）。
#   下面标【保密】的几个【绝不能】加 NEXT_PUBLIC_ 前缀，只在服务端用。
# =====================================================================

# ---------- Supabase（数据库 + Auth + 存储） ----------
# 用前两步（一次性）：
#   1. Supabase 后台 → SQL Editor 跑一遍 supabase/migrations/0001_comments.sql 建表
#   2. Authentication → Sign In / Providers → 打开 "Anonymous" 开关（无感匿名登录靠它）
# Supabase 后台 → Project Settings → API 拿下面三个值。
# URL 和 anon key 是公开安全的（靠 RLS 保护），可进客户端：
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 【保密】service_role key 会【绕过 RLS】，只在服务端 Route Handler 用，严禁进前端：
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Cloudflare Turnstile（人机验证） ----------
# Turnstile 后台 → 你的 Site
# Site Key 公开（前端渲染验证组件用）：
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 【保密】Secret Key（服务端校验用户的验证 token）：
TURNSTILE_SECRET_KEY=

# ---------- Upstash Redis（限流） ----------
# Upstash 后台 → 你的 Redis → REST API。两个都【保密】，只在服务端用：
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- 站长身份（作者徽章 / 审核后台） ----------
# 【保密】P1 用这个密钥登录 /admin/comments 审核后台 + 让你的留言带"作者"徽章。
# 自己随便设一个长口令（像设密码一样）：
COMMENTS_ADMIN_SECRET=

# P2 接入真实登录后才用到：逗号分隔的邮箱白名单（先留空）。
# COMMENTS_ADMIN_EMAILS=you@example.com

# ---------- 图片审核（P3，现在留空） ----------
# P3 接图片上传时才需要；Sightengine 后台 → API Credentials。两个都【保密】：
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
