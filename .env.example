# =====================================================================
# YakRigged 环境变量示例
# 复制为 .env.local（本地）或在 Vercel Project Settings → Environment Variables
# 里逐项配置。所有 NEXT_PUBLIC_* 都会进客户端 bundle，请勿放敏感信息。
# =====================================================================

# 站点正式域名（影响 canonical / sitemap / RSS / OG）。
# 部署到正式域名时必填。本地开发可以不填，会 fallback 到 yakrigged.com。
NEXT_PUBLIC_SITE_URL=https://yakrigged.com

# Google Search Console 验证（"meta tag" 模式，把 content 值粘进来）
# 在 Search Console 添加资源后，选择 HTML 标记验证方式：
#   <meta name="google-site-verification" content="XXXXX">
# 把 XXXXX 粘到下面即可。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools 验证（同上，meta 模式）
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# =====================================================================
# Newsletter 配置
# ---------------------------------------------------------------------
# 没配置时订阅表单显示 "Coming soon"，不会真请求第三方。
# 当前支持的 provider：
#   - kit       （默认推荐 —— ConvertKit / Kit；免费 10K 订阅；无 KYC）
#   - beehiiv   （需 Stripe Identity 验证，已不推荐做主力）
# =====================================================================

# 切换 provider 时改这里
NEWSLETTER_PROVIDER=kit

# ---------- 选项 A：Kit (ConvertKit) ----------
# 1. 去 kit.com 注册账号
# 2. 创建一个 Form（Forms → + Create New → Inline form 即可，默认 single-opt-in）
# 3. API Key:    Settings → Advanced → "V3 API Key"（不是 API Secret，前者权限刚好够）
# 4. Form ID:    打开 Form 后地址栏 /forms/<这串数字>/ —— 复制那串数字
KIT_API_KEY=
KIT_FORM_ID=

# ---------- 选项 B：Beehiiv（备用） ----------
# 在 Beehiiv 后台 → Settings → Integrations → API 拿到（需先做 Stripe 验证）
BEEHIIV_API_KEY=
# 在 Beehiiv 后台 → Settings → Publication ID（V2 那个，pub_ 开头）
BEEHIIV_PUBLICATION_ID=
